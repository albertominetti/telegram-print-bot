# Environment variables for the bot (loaded by systemd via EnvironmentFile).
# Copy to config.env, adjust values, then: chmod 600 config.env

TELEGRAM_BOT_TOKEN=bot_token_here
CUPS_PRINTER_NAME=PrinterName

USE_SAMBA=false
SAMBA_HOST=192.168.1.XXX
SAMBA_SHARE=PrinterShareName
SAMBA_USER=windows_user
SAMBA_PASSWORD=windows_password

# Mandatory comma-separated Telegram user IDs (get yours from @userinfobot)
ALLOWED_USER_IDS=123456789

# Environment variables for the bot (loaded by systemd via EnvironmentFile).
# Copy to config.env, adjust values, then: chmod 600 config.env

TELEGRAM_BOT_TOKEN=your_bot_token_here

# Comma-separated CUPS queue names (lpstat -p). /printer picks one for everyone.
PRINTERS=xerox,office_hp
DEFAULT_PRINTER=xerox

USE_SAMBA=false
SAMBA_HOST=192.168.1.XXX
SAMBA_SHARE=PrinterShareName
SAMBA_USER=windows_user
SAMBA_PASSWORD=windows_password

# Comma-separated Telegram user IDs (get yours from @userinfobot)
ALLOWED_USER_IDS=123456789

# Optional Wake-on-LAN for Windows PCs that sleep. Leave unset to skip.
# Parallel to PRINTERS (empty slot = no WoL), or name=MAC pairs.
# WOL_MACS=AA:BB:CC:DD:EE:FF
# WOL_MACS=xerox=AA:BB:CC:DD:EE:FF,office_hp=11:22:33:44:55:66
# Host used to detect "already awake" / "woke up" (SMB port 445, then ping).
# If omitted, the bot tries the CUPS device URI (`lpstat -v`). Samba uses SAMBA_HOST.
# WOL_HOSTS=192.168.1.10
# WOL_HOSTS=xerox=192.168.1.10
# SAMBA_WOL_MAC=AA:BB:CC:DD:EE:FF
# WOL_BROADCAST=255.255.255.255
# WOL_PORT=9
# WOL_WAIT_SECONDS=90
# WOL_POLL_SECONDS=3
# WOL_READY_GRACE_SECONDS=8

[Unit]
Description=Telegram PDF Print Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=1000
WorkingDirectory=/opt/telegram-print-bot

# --- uv venv (default) ---
ExecStart=/opt/telegram-print-bot/.venv/bin/python bot.py

Restart=always
RestartSec=10

EnvironmentFile=/opt/telegram-print-bot/config.env

StandardOutput=journal
StandardError=journal
SyslogIdentifier=telegram-print-bot

[Install]
WantedBy=multi-user.target
